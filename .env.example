# Copy to .env and fill in. Values already present in the process environment
# take precedence (this file only fills gaps).

# Any OpenAI-compatible chat-completions endpoint works.
DEEPSEEK_BASE_URL=https://api.deepseek.com
LABSCRIBE_LLM_MODEL=deepseek-chat

# Preferred project-specific variable. Falls back to DEEPSEEK_API_KEY.
LABSCRIBE_LLM_API_KEY=

# llm | rules | off
LABSCRIBE_AGENT_MODE=llm

# Override storage locations if needed
# LABSCRIBE_DB_PATH=data/labscribe.db
# LABSCRIBE_FRAMES_DIR=data/frames
